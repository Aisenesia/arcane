# --- Server ---
PORT=3001

# --- Database ---
# Set USE_REMOTE_DB=true to use MONGODB_URI, otherwise LOCAL_MONGODB_URI is used.
USE_REMOTE_DB=false
LOCAL_MONGODB_URI=mongodb://localhost:27017/arcanegambit
MONGODB_URI=

# --- Auth ---
# Use a long, random value in production (e.g. `openssl rand -base64 32`).
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# --- Admin bootstrap (optional) ---
# If unset, an "admin" account is created with a random password printed once on first boot.
ADMIN_EMAIL=admin
ADMIN_PASSWORD=

# --- Email (SMTP) for password recovery ---
SMTP_USER=your-address@gmail.com
SMTP_PASS=your-app-password
SMTP_HOST=smtp-relay.gmail.com
SMTP_PORT=587

# --- HTTPS (optional) ---
# Provide both to serve over HTTPS instead of HTTP.
TLS_KEY_PATH=
TLS_CERT_PATH=
